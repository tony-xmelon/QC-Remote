{
  "name": "qc-remote-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/android",
    "apps/windows",
    "packages/typescript/*"
  ],
  "scripts": {
    "dev:android": "npm run dev --workspace @qc-remote/android",
    "build:android:web": "npm run build --workspace @qc-remote/android",
    "android:sync": "npm run android:sync --workspace @qc-remote/android",
    "android:open": "npm run android:open --workspace @qc-remote/android",
    "android:build:debug": "npm run android:build:debug --workspace @qc-remote/android",
    "android:prepare:firebase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-android-firebase.ps1 -PrepareOnly",
    "android:publish:firebase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-android-firebase.ps1",
    "dev:windows": "npm run dev --workspace @qc-remote/windows",
    "build:windows": "npm run build --workspace @qc-remote/windows",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "tauri:dev": "npm run tauri:dev --workspace @qc-remote/windows",
    "tauri:build": "node scripts/version-app.mjs sync && npm run tauri:build --workspace @qc-remote/windows",
    "version:app:patch": "node scripts/version-app.mjs patch",
    "version:app:minor": "node scripts/version-app.mjs minor",
    "version:app:major": "node scripts/version-app.mjs major",
    "version:app:set": "node scripts/version-app.mjs",
    "version:android:patch": "node scripts/version-app.mjs android patch",
    "version:android:minor": "node scripts/version-app.mjs android minor",
    "version:android:major": "node scripts/version-app.mjs android major",
    "version:android:set": "node scripts/version-app.mjs android",
    "protocol:generate": "node scripts/generate-qc-usb-profile.mjs && node scripts/generate-qc-relay-profile.mjs && node scripts/generate-qc-domain.mjs && node scripts/generate-gateway-bindings.mjs && node scripts/generate-qc-actions.mjs && node scripts/generate-qc-payloads.mjs",
    "protocol:check": "node scripts/generate-qc-usb-profile.mjs --check && node scripts/generate-qc-relay-profile.mjs --check && node scripts/generate-qc-domain.mjs --check && node scripts/generate-gateway-bindings.mjs --check && node scripts/generate-qc-actions.mjs --check && node scripts/generate-qc-payloads.mjs --check && python tools/verify_python_mcp_signatures.py",
    "gateway:coverage": "node tools/verify-gateway-method-coverage.mjs",
    "app-parity:check": "node tools/verify-app-parity.mjs",
    "mcp-parity:check": "node tools/verify-mcp-platform-parity.mjs",
    "parity:pyquadcortex": "node tools/verify-pyquadcortex-parity.mjs",
    "parity:pyquadcortex:github": "node tools/verify-pyquadcortex-parity.mjs --github",
    "parity:protocol-extensions": "node tools/verify-extracted-protocol-parity.mjs",
    "native:runtime-boundary": "node tools/verify-native-runtime-boundary.mjs",
    "test": "npm run native:runtime-boundary && npm run audit:assets && npm run test:core && npm run test:frontend && npm test --workspace @qc-remote/android",
    "test:assistant": "npm run test:frontend",
    "test:core": "npm test --workspace @qc-remote/core",
    "test:frontend": "node --experimental-strip-types --test tests/all-device-parameters.test.ts tests/architecture-boundaries.test.ts tests/assistant.test.ts tests/block-visuals.test.ts tests/connection-workflow.test.ts tests/coros-ui.test.ts tests/deduplication.test.ts tests/footswitch-leds.test.ts tests/hardware-conformance.test.ts tests/legal-release.test.ts tests/parameter-editor.test.ts tests/qc-action-executor.test.ts tests/qc-action-outcome.test.ts tests/qc-transport.test.ts tests/relay-client.test.ts tests/release-integration.test.ts tests/release-provenance.test.ts tests/theme.test.ts tests/voice.test.ts",
    "test:theme": "npm run theme:check && npm run audit:assets && node --experimental-strip-types --test tests/theme.test.ts && powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-qc-theme.ps1",
    "audit:assets": "node tools/audit-repository-assets.mjs",
    "theme:sync": "node scripts/sync-theme-assets.mjs",
    "theme:check": "node scripts/sync-theme-assets.mjs --check",
    "test:hardware:plan": "node tools/hardware-conformance.mjs",
    "test:hardware:backup": "node tools/verify-native-backup.mjs",
    "test:hardware:windows": "node tools/run-hardware-release.mjs windows",
    "test:hardware:android": "node tools/run-hardware-release.mjs android",
    "test:hardware:release": "node tools/verify-hardware-release.mjs artifacts/hardware-conformance/windows.json artifacts/hardware-conformance/android.json",
    "test:parity:software": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-software-parity.ps1",
    "architecture:check": "node tools/verify-package-boundaries.mjs",
    "release:provenance": "node tools/release-provenance.mjs",
    "release:source": "node tools/create-public-source-release.mjs",
    "legal:notices": "node tools/generate-third-party-inventory.mjs",
    "legal:secrets": "node tools/verify-no-tracked-secrets.mjs",
    "legal:publication-boundaries": "node tools/verify-private-publication-boundaries.mjs",
    "legal:data-flows": "node tools/verify-data-flow-inventory.mjs",
    "legal:data-minimization": "node tools/verify-assistant-data-minimization.mjs",
    "legal:providers": "node tools/verify-public-provider-boundary.mjs",
    "legal:visual-boundary": "node tools/verify-release-visual-boundary.mjs",
    "legal:source-ip": "node tools/verify-public-source-ip-boundary.mjs",
    "legal:licenses": "node tools/verify-third-party-license-obligations.mjs",
    "legal:project-license": "node tools/verify-first-party-license-policy.mjs",
    "legal:check": "node tools/verify-public-release-legal.mjs",
    "test:ui": "playwright test",
    "verify:qc-corpora": "node tools/verify-qc-ui-corpora.mjs",
    "verify:qc-screen-text": "python tools/verify_screen_tree_coverage.py",
    "verify:qc-coverage": "node tools/verify_qc_screen_coverage.mjs && node tools/verify_qc_physical_capture_plan.mjs",
    "verify:qc-iconography": "node tools/verify-qc-iconography.mjs",
    "verify:qc-iconography:complete": "node tools/verify-qc-iconography.mjs --require-complete-coverage",
    "verify:qc-typography": "node tools/verify-qc-typography.mjs",
    "compare:qc-typography": "python tools/compare_qc_typography.py",
    "report:qc-typography": "node tools/write-qc-typography-report.mjs",
    "compare:qc-iconography": "python tools/compare_qc_iconography.py --require-exact-colors",
    "report:qc-coverage": "node tools/report_qc_screen_coverage.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "security:platform": "node tools/verify-release-platform-security.mjs",
    "security:incidents": "node tools/verify-release-incidents.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:cortex-protocol": "python tools/generate_cortex_protos.py --check && python tools/generate_cortex_message_registry.py --check && python tools/verify_cortex_protocol_fidelity.py && python tools/verify_cortex_protocol_message_types.py",
    "verify:qc-geometry": "python tools/verify_screen_geometry.py",
    "verify:test-assertions": "node tools/audit_vacuous_assertions.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}
